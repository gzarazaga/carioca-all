{
  "cli": {
    "version": ">= 21.4.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://carioca-ux.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://carioca-ux.onrender.com/ws"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://carioca-ux.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://carioca-ux.onrender.com/ws"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://carioca-ux.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://carioca-ux.onrender.com/ws"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
